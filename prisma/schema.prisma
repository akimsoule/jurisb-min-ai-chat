// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    password  String // Hashed password
    name      String
    credits   Int      @default(0)
    plan      String   @default("Gratuit")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

model StripeEvent {
    id        String   @id @default(cuid())
    eventId   String   @unique // Stripe event ID pour idempotence
    type      String
    userId    String
    amount    Int
    credits   Int
    status    String   @default("pending")
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([eventId])
    @@map("stripe_events")
}
